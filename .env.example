# Copy to .env on the server. Never commit real secrets.

# Secret used to sign JWT tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the API server listens on (Render/Railway provide PORT automatically)
PORT=3001

# Where SQLite database and uploaded files are stored.
# On hosts with a persistent disk, point this to the mounted volume (e.g. /data).
DATA_DIR=

# Comma-separated list of allowed browser origins, or * for all.
CORS_ORIGIN=*

# Base URL used in uploaded file URLs. Leave empty to derive from the request.
PUBLIC_URL=
